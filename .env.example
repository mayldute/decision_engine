# =============================================================================
# Application
# =============================================================================

APP__APP_NAME=DecisionEngine
APP__DEBUG=True
APP__ENV=test 


# =============================================================================
# PostgreSQL
# =============================================================================

DATABASE__DB_LOGIN=decision_engine
DATABASE__DB_PASS=decision_engine
DATABASE__DB_HOST=localhost
DATABASE__DB_PORT=5432
DATABASE__DB_NAME=decision_engine

DATABASE__DATABASE_URL=postgresql+asyncpg://decision_engine:decision_engine@localhost:5432/decision_engine
DATABASE__TEST_DATABASE_URL=postgresql+asyncpg://decision_engine_test:decision_engine_test@localhost:5432/decision_engine_test


# =============================================================================
# JWT
# Generate a secret with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

JWT__JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT__JWT_ALGORITHM=HS256
JWT__JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT__JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
